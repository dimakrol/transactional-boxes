FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json nest-cli.json ./
COPY apps/balance-sync-service ./apps/balance-sync-service
RUN npx nest build balance-sync-service

FROM node:22-alpine AS runtime
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
ENV NODE_ENV=production
COPY --from=build /app/dist/apps/balance-sync-service ./dist/apps/balance-sync-service
COPY drizzle.config.balance-sync-service.ts ./
COPY apps/balance-sync-service/drizzle ./apps/balance-sync-service/drizzle
COPY apps/balance-sync-service/src/db/schema.ts ./apps/balance-sync-service/src/db/schema.ts

EXPOSE 3001
CMD ["node", "dist/apps/balance-sync-service/main.js"]
