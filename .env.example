# Postgres — service A
POSTGRES_DB_A=service_a
POSTGRES_USER_A=service_a
POSTGRES_PASSWORD_A=service_a
POSTGRES_PORT_A=5433

# Postgres — service B
POSTGRES_DB_B=service_b
POSTGRES_USER_B=service_b
POSTGRES_PASSWORD_B=service_b
POSTGRES_PORT_B=5434

# App ports
PORT_TRANSACTIONS_SERVICE=3000
PORT_TRANSACTIONS_SERVICE_2=3002
PORT_BALANCE_SYNC_SERVICE=3001

# Kafka
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_TOPIC_BALANCE_UPDATES=balance-updates
KAFKA_TOPIC_BALANCE_UPDATES_DLQ=balance-updates.dlq
KAFKA_CONSUMER_GROUP_ID=balance-sync-service-balance-updates

# Observability
GRAFANA_PORT=3300
LOG_LEVEL=info

# Business tuning
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=3
BALANCE_UPDATE_MAX_ATTEMPTS=5
INBOX_MAX_PROCESSING_ATTEMPTS=3
